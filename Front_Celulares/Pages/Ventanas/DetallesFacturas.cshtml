@page
@model DetallesFacturasModel
@{
    ViewData["Title"] = "DetallesFacturas";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">DetallesFacturas</h1>
        <div>
            <input type="submit"
                value="Consultar"
                class="btn btn-secondary"
                asp-page-handler="BtConsultar"/>
            <input type="submit"
                value="Nuevo"
                class="btn btn-secondary"
                asp-page-handler="BtNuevo"/>
            <input type="submit"
                value="Guardar"
                class="btn btn-secondary"
                asp-page-handler="BtGuardar"/>
            <input id="flTotal" 
                placeholder="Total"
                asp-for="@Model.Filtro!.Total"/>
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }
        
        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Detalles Facturas</h3>

                <label>
                    Cantidad
                </label>
                <input id=nmCantidad"
                    asp-for="@Model.Actual!.Cantidad"/>
                <br />

                <label>
                    <label>
                    SubTotal
                </label>
                <input id=nmSubtotal"
                    asp-for="@Model.Actual!.Subtotal"/>
                <br />

                <label>
                    <label>
                        Iva
                    </label>
                    <input id=nmIva"
                           asp-for="@Model.Actual!.Iva" />
                    <br />

                <label>
                    <label>
                        Total
                    </label>
                    <input id=nmTotal"
                           asp-for="@Model.Actual!.Total" />
                    <br />
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar la asignacion con información 
                            @Model.Actual!.Cantidad,
                            @Model.Actual!.Subtotal,
                            @Model.Actual!.Iva,
                            @Model.Actual!.Total?
                    </h4>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtConsultar"/>
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar"/>
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Cantidad</th>
                        <th>SubTotal</th>
                        <th>Iva</th>
                        <th>Total</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Cantidad</td>
                                <td>@elemento.Subtotal</td>
                                <td>@elemento.Iva</td>
                                <td>@elemento.Total</td>
                                <td>
                                    <input type="submit"
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id"/>
                                    <input type="submit"
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id"/>
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

        </div>
</form>