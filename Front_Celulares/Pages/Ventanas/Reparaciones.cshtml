@page
@model ReparacionesModel
@{
    ViewData["Title"] = "Reparaciones";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Reparaciones</h1>
        <div>
            <input type="submit"
                value="Consultar"
                class="btn btn-secondary"
                asp-page-handler="BtConsultar"/>
            <input type="submit"
                value="Nuevo"
                class="btn btn-secondary"
                asp-page-handler="BtNuevo"/>
            <input type="submit"
                value="Guardar"
                class="btn btn-secondary"
                asp-page-handler="BtGuardar"/>
            <input id="flId" 
                placeholder="Id"
                asp-for="@Model.Filtro!.Id"/>
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
        }
        
        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Reparaciones</h3>

                <label>
                    Id del Celular
                </label>
                <input id="nmCelularId"
                    asp-for="@Model.Actual!.CelularId"/>
                <br />

                <label>
                    Id del Tecnico
                </label>
                <input id="nmTecnicoId"
                    asp-for="@Model.Actual!.TecnicoId"/>
                <br />

                <label>
                    Id del Cliente
                </label>
                <input id="nmClienteId"
                    asp-for="@Model.Actual!.ClienteId"/>
                <br />

                <label>
                    Id del Bono (opcional)
                </label>
                <input id="nmBonoId"
                    asp-for="@Model.Actual!.BonoId"/>
                <br />

                <label>
                    FechaIngreso
                </label>
                <input id="nmFechaIngreso"
                    asp-for="@Model.Actual!.FechaIngreso"/>
                <br />

                <label>
                    FechaEntrega
                </label>
                <input id="nmFechaEntrega"
                    asp-for="@Model.Actual!.FechaEntrega"/>
                <br />

                <label>
                    Estado
                </label>
                <input id="nmEstado"
                    asp-for="@Model.Actual!.Estado"/>
                <br />

            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar la asignacion con información 
                            @Model.Actual!.FechaIngreso,
                            @Model.Actual!.FechaEntrega,
                            @Model.Actual!.Estado,
                    </h4>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtConsultar"/>
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar"/>
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>FechaIngreso</th>
                        <th>FechaEntrega</th>
                        <th>Estado</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.FechaIngreso</td>
                                <td>@elemento.FechaEntrega</td>
                                <td>@elemento.Estado</td>
                                <td>
                                    <input type="submit"
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id"/>
                                    <input type="submit"
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id"/>
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

        </div>
</form>