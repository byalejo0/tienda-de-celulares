@page
@model DevolucionesModel
@{
    ViewData["Title"] = "Devoluciones";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Devoluciones</h1>
        <div>
            <input type="submit"
                value="Consultar"
                class="btn btn-secondary"
                asp-page-handler="BtConsultar"/>
            <input type="submit"
                value="Nuevo"
                class="btn btn-secondary"
                asp-page-handler="BtNuevo"/>
            <input type="submit"
                value="Guardar"
                class="btn btn-secondary"
                asp-page-handler="BtGuardar"/>
            <input id="flId" 
                placeholder="Id"
                asp-for="@Model.Filtro!.Id"/>
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
        }
        
        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Devoluciones</h3>

                <label>
                    Id de la Factura
                </label>
                <input id="nmFacturaId"
                    asp-for="@Model.Actual!.FacturaId"/>
                <br />

                <label>
                    Id del Cliente
                </label>
                <input id="nmClienteId"
                    asp-for="@Model.Actual!.ClienteId"/>
                <br />

                <label>
                    FechaDevolucion
                </label>
                <input id="nmFechaDevolucion"
                    asp-for="@Model.Actual!.FechaDevolucion"/>
                <br />

                <label>
                    Motivo
                </label>
                <input id="nmMotivo"
                    asp-for="@Model.Actual!.Motivo"/>
                <br />

                <label>
                    ValorDevuelto
                </label>
                <input id="nmValorDevuelto"
                    asp-for="@Model.Actual!.ValorDevuelto"/>
                <br />
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar la asignacion con información 
                            @Model.Actual!.FechaDevolucion,
                            @Model.Actual!.Motivo,
                            @Model.Actual!.ValorDevuelto?
                    </h4>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtConsultar"/>
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar"/>
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>FechaDevolucion</th>
                        <th>Motivo</th>
                        <th>ValorDevuelto</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.FechaDevolucion</td>
                                <td>@elemento.Motivo</td>
                                <td>@elemento.ValorDevuelto</td>
                                <td>
                                    <input type="submit"
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id"/>
                                    <input type="submit"
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id"/>
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

        </div>
</form>