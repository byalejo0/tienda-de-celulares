@page
@model FacturasModel
@{
    ViewData["Title"] = "Facturas";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Facturas</h1>
        <div>
            <input type="submit"
                value="Consultar"
                class="btn btn-secondary"
                asp-page-handler="BtConsultar"/>
            <input type="submit"
                value="Nuevo"
                class="btn btn-secondary"
                asp-page-handler="BtNuevo"/>
            <input type="submit"
                value="Guardar"
                class="btn btn-secondary"
                asp-page-handler="BtGuardar"/>
            <input id="flId" 
                placeholder="Id"
                asp-for="@Model.Filtro!.Id"/>
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml")
        }
        
        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Facturas</h3>

                <label>
                    Id del Cliente
                </label>
                <input id="nmClienteId"
                    asp-for="@Model.Actual!.ClienteId"/>
                <br />

                <label>
                    Id del Trabajador
                </label>
                <input id="nmTrabajadorId"
                    asp-for="@Model.Actual!.TrabajadorId"/>
                <br />

                <label>
                    Id de la Reparacion (opcional)
                </label>
                <input id="nmReparacionId"
                    asp-for="@Model.Actual!.ReparacionId"/>
                <br />

                <label>
                    Fecha
                </label>
                <input id="nmFecha"
                    asp-for="@Model.Actual!.Fecha"/>
                <br />

                <label>
                    SubTotal
                </label>
                <input id="nmSubtotal"
                    asp-for="@Model.Actual!.Subtotal"/>
                <br />

                <label>
                    Iva
                </label>
                <input id="nmIva"
                    asp-for="@Model.Actual!.Iva"/>
                <br />

                <label>
                    Total
                </label>
                <input id="nmTotal"
                    asp-for="@Model.Actual!.Total"/>
                <br />
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar la asignacion con información 
                            @Model.Actual!.Fecha,
                            @Model.Actual!.Subtotal,
                            @Model.Actual!.Iva,
                            @Model.Actual!.Total?
                    </h4>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtConsultar"/>
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar"/>
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Fecha</th>
                        <th>SubTotal</th>
                        <th>Iva</th>
                        <th>Total</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Fecha</td>
                                <td>@elemento.Subtotal</td>
                                <td>@elemento.Iva</td>
                                <td>@elemento.Total</td>
                                <td>
                                    <input type="submit"
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id"/>
                                    <input type="submit"
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id"/>
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

        </div>
</form>