@page
@model UsuariosModel
@{
    ViewData["Title"] = "Usuarios";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Usuarios</h1>
        <div>
            <input type="submit"
                value="Consultar"
                class="btn btn-secondary"
                asp-page-handler="BtConsultar"/>
            <input type="submit"
                value="Nuevo"
                class="btn btn-secondary"
                asp-page-handler="BtNuevo"/>
            <input type="submit"
                value="Guardar"
                class="btn btn-secondary"
                asp-page-handler="BtGuardar"/>
            <input id="flNombre_Usuario" 
                placeholder="Nombre Usuario"
                asp-for="@Model.Filtro!.Nombre_Usuario"/>
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }
        
        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Usuario</h3>

                <label>
                    Nombre Usuario
                </label>
                <input id=nmNombre_Usuario"
                    asp-for="@Model.Actual!.Nombre_Usuario"/>
                <br />

                <label>
                    Contraseña
                </label>
                <input id=nmContraseña"
                    asp-for="@Model.Actual!.Contraseña"/>
                <br />
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar la asignacion con información 
                            @Model.Actual!.Nombre_Usuario,
                            @Model.Actual!.Contraseña
                    </h4>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtConsultar"/>
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar"/>
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Nombre Usuario</th>
                        <th>Contraseña</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Nombre_Usuario</td>
                                <td>@elemento.Contraseña</td>
                                <td>
                                    <input type="submit"
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id"/>
                                    <input type="submit"
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id"/>
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

        </div>
</form>