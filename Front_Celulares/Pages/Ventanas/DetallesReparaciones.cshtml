@page
@model DetallesReparacionesModel
@{
    ViewData["Title"] = "DetallesReparaciones";
}
<form method="post"
    enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">DetallesReparaciones</h1>
        <div>
            <input type="submit"
                value="Consultar"
                class="btn btn-secondary"
                asp-page-handler="BtConsultar"/>
            <input type="submit"
                value="Nuevo"
                class="btn btn-secondary"
                asp-page-handler="BtNuevo"/>
            <input type="submit"
                value="Guardar"
                class="btn btn-secondary"
                asp-page-handler="BtGuardar"/>
            <input id="flCantidad" 
                placeholder="Cantidad"
                asp-for="@Model.Filtro!.Cantidad"/>
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }
        
        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden"
                asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>DetallesReparaciones</h3>

                <label>
                    Diagnostico
                </label>
                <input id=nmDiagnostico"
                    asp-for="@Model.Actual!.Diagnostico"/>
                <br />

                <label>
                    Servicio Realizado
                </label>
                <input id=nmServicioRealizado"
                    asp-for="@Model.Actual!.ServicioRealizado"/>
                <br />

                <label>
                    Componente Reemplazado
                </label>
                <input id=nmComponenteReemplazado"
                       asp-for="@Model.Actual!.ComponenteReemplazado" />
                <br />

                <label>
                    Cantidad
                </label>
                <input id=nmCantidad"
                       asp-for="@Model.Actual!.Cantidad" />
                <br />

                <label>
                    Precio
                </label>
                <input id=nmPrecio"
                       asp-for="@Model.Actual!.Precio" />
                <br />

                <label>
                    Subtotal
                </label>
                <input id=nmSubtotal"
                       asp-for="@Model.Actual!.Subtotal" />
                <br />
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>
                        Mensaje
                    </h3>

                    <h4>
                        ¿Quiere borrar la asignacion con información 
                            @Model.Actual!.Diagnostico,
                            @Model.Actual!.ServicioRealizado,
                            @Model.Actual!.ComponenteReemplazado,
                            @Model.Actual!.Cantidad,
                            @Model.Actual!.Precio,
                            @Model.Actual!.Subtotal?
                    </h4>
                    <input type="submit"
                        value="Cancelar"
                        class="btn btn-secondary"
                        asp-page-handler="BtConsultar"/>
                    <input type="submit"
                        value="Borrar"
                        class="btn btn-secondary"
                        asp-page-handler="BtBorrar"/>
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br />
            <br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Cantidad</th>
                        <th>Servicio Realizado</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Diagnostico</td>
                                <td>@elemento.ServicioRealizado</td>
                                <td>@elemento.ComponenteReemplazado</td>
                                <td>@elemento.Cantidad</td>
                                <td>@elemento.Precio</td>
                                <td>@elemento.Subtotal</td>
                                <td>
                                    <input type="submit"
                                        value="Editar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtEditar"
                                        asp-route-data="@elemento.Id"/>
                                    <input type="submit"
                                        value="Borrar"
                                        class="btn btn-secondary"
                                        asp-page-handler="BtPregBorrar"
                                        asp-route-data="@elemento.Id"/>
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }

        </div>
</form>